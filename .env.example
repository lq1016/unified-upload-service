# ===== 服务 =====
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ===== 数据库 =====
DB_PATH=./data/upload.db

# ===== 存储后端：local | s3 =====
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data

# ===== 对象存储（S3 兼容，仅 STORAGE_DRIVER=s3 时使用；不得硬编码到源码） =====
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# 私有桶签名访问 URL 有效期（秒）
SIGNED_URL_TTL=300

# ===== 上传限制 =====
MAX_FILE_SIZE=2147483648          # 2GB
CHUNK_SIZE=5242880                # 5MB
ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,application/pdf,application/octet-stream
ALLOWED_EXT=jpg,jpeg,png,webp,gif,pdf,bin

# ===== 图片处理 =====
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1920
IMAGE_FORMAT=webp
WATERMARK_TEXT=InteMatrix
WATERMARK_POSITION=bottom-right    # top-left|top-right|bottom-left|bottom-right|center
WATERMARK_OPACITY=0.35

# ===== 访问鉴权 JWT（HS256） =====
JWT_SECRET=change-me-in-production
JWT_TTL=3600

# ===== 测试账号（README 中说明） =====
# 由 scripts/seed.ts 写入数据库
